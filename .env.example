# Copy this file to .env.local and fill in the values.

# PostgreSQL connection string. Create the database first:  CREATE DATABASE planmate;
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/planmate

# Planning model.
#   mock               -> built-in rule-based planner, no model needed (default)
#   openai-compatible  -> any server exposing POST {LLM_BASE_URL}/chat/completions
#                         (Ollama, LM Studio, vLLM, llama.cpp server, or a custom FastAPI app)
LLM_PROVIDER=mock
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=planmate
# LLM_API_KEY=
# LLM_TIMEOUT_MS=120000

